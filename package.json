{
  "name": "mediahub-desktop",
  "version": "1.7.0",
  "description": "Vido — 视频抓取、格式转换、批量重命名一站式工具。慧天科技出品，Mac/Windows 安装即用，文件始终留在本机。",
  "main": "main/main.js",
  "author": "慧天科技",
  "company": "慧天科技",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "icon": "node tools/make-icon.js",
    "dist:mac": "bash tools/build-mac.sh",
    "dist:mac:dir": "electron-builder --mac --x64 --dir --publish never --config.electronDist=node_modules/electron/dist",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.mediahub.desktop",
    "productName": "Vido",
    "copyright": "Copyright © 2026 慧天科技",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "main/**/*",
      "renderer/**/*",
      "charset-data/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "charset-data",
        "to": "charset-data"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "identity": null,
      "darkModeSupport": true,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSHumanReadableCopyright": "Copyright © 2026 慧天科技",
        "LSApplicationCategoryType": "public.app-category.utilities"
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Vido"
    }
  }
}
